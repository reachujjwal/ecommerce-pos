# ============================================================
# ROOT .gitignore — E-Commerce Full Stack Project
# ============================================================

# ──────────────────────────────────────────────
# JSON files to IGNORE (sensitive / generated)
# ──────────────────────────────────────────────
# Firebase / Google service account credentials
**/google-services.json
**/firebase-adminsdk*.json
**/serviceAccountKey.json

# AWS / cloud credentials
**/aws-credentials.json
**/credentials.json

# Any local secrets / config overrides
**/secrets.json
**/local-config.json
**/env-config.json

# ──────────────────────────────────────────────
# Spring Boot / Java (ecommerce-backend)
# ──────────────────────────────────────────────
ecommerce-backend/target/
ecommerce-backend/.mvn/wrapper/maven-wrapper.jar
ecommerce-backend/.mvn/wrapper/MavenWrapperDownloader.java

# Maven
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# Spring Boot application secrets (keep application.properties template, ignore local overrides)
ecommerce-backend/src/main/resources/application-local.properties
ecommerce-backend/src/main/resources/application-secret.properties
ecommerce-backend/src/main/resources/application-prod.properties

# ──────────────────────────────────────────────
# Node.js / React / Vite (ecommerce-frontend)
# ──────────────────────────────────────────────
ecommerce-frontend/node_modules/
ecommerce-frontend/dist/
ecommerce-frontend/build/
ecommerce-frontend/.vite/
ecommerce-frontend/.next/

# Local env files
ecommerce-frontend/.env
ecommerce-frontend/.env.local
ecommerce-frontend/.env.development.local
ecommerce-frontend/.env.test.local
ecommerce-frontend/.env.production.local

# Package manager lock files (keep package-lock.json but ignore yarn.lock / pnpm-lock if not used)
# Uncomment the one you don't use:
# ecommerce-frontend/yarn.lock
# ecommerce-frontend/pnpm-lock.yaml

# ──────────────────────────────────────────────
# IDEs & Editors
# ──────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ──────────────────────────────────────────────
# OS generated files
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ──────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ──────────────────────────────────────────────
# Docker
# ──────────────────────────────────────────────
# Keep docker-compose.yml but ignore any override files with secrets
docker-compose.override.yml

# ──────────────────────────────────────────────
# Miscellaneous
# ──────────────────────────────────────────────
*.tmp
*.bak
*.orig
